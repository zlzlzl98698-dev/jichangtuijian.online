---
import { navigationStructure } from '../data/navigation';

// Clean, compact titles for top-level navbar to guarantee zero line-wrapping
const navLinks = [
  { title: '机场推荐', slug: '/rankings', subTopics: navigationStructure[0].subTopics },
  { title: '42强评测', slug: '/brands', subTopics: navigationStructure[1].subTopics },
  { 
    title: '选型雷达', 
    slug: '/best-airports', 
    isHighlight: true,
    subTopics: [
      { title: '42家全景推荐', slug: '/best-airports', description: '42家机场综合横评与选型决策指南' },
      { title: '免费试用大全', slug: '/trial', description: '0元试用与1元体验避坑清单与压测' },
      { title: '跑路预警雷达', slug: '/scam-radar', description: '资金链断裂前兆与7大红色预警信号' },
      { title: '免费节点真相', slug: '/free-nodes', description: '白嫖节点安全风险与中间人窃密实测' },
      { title: '机场百科FAQ', slug: '/faq', description: '100个核心技术与疑难全解问答库' },
    ] 
  },
  { title: '场景加速', slug: '/scenarios', subTopics: navigationStructure[2].subTopics },
  { title: '客户端教程', slug: '/clients', subTopics: navigationStructure[3].subTopics },
  { title: '协议实验室', slug: '/tech', subTopics: navigationStructure[4].subTopics },
];
---

<header class="sticky top-0 z-40 w-full border-b border-[#1f2e4a] bg-[#070c14]/95 backdrop-blur-md">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between gap-4">
    <!-- Brand Logo -->
    <a href="/" class="flex items-center space-x-2.5 group shrink-0">
      <img
        src="/avatar.webp"
        alt="机场online 头像"
        class="w-9 h-9 rounded-xl object-cover object-top border border-cyan-500/50 shadow-md shadow-cyan-500/20 group-hover:scale-105 group-hover:border-cyan-400 transition-all shrink-0"
      />
      <div class="flex flex-col">
        <div class="flex items-center space-x-1.5 leading-none">
          <span class="font-bold text-base tracking-tight text-white group-hover:text-cyan-400 transition-colors whitespace-nowrap">
            机场online
          </span>
          <span class="text-[9px] font-mono px-1 py-0.5 rounded bg-cyan-950 text-cyan-400 border border-cyan-800 whitespace-nowrap">
            2026
          </span>
        </div>
        <span class="text-[10px] font-mono text-slate-500 leading-tight mt-0.5 whitespace-nowrap">
          jichangtuijian.online
        </span>
      </div>
    </a>

    <!-- Desktop Navigation Links -->
    <nav class="hidden xl:flex items-center space-x-1 shrink-0">
      {navLinks.map((item) => (
        <div class="relative group">
          <a
            href={item.slug}
            class={`px-3 py-2 rounded-lg text-sm font-medium transition-colors flex items-center space-x-1 whitespace-nowrap ${
              item.isHighlight
                ? 'text-amber-300 hover:text-white bg-amber-950/30 border border-amber-800/40 hover:bg-amber-950/60'
                : 'text-slate-300 hover:text-white hover:bg-slate-800/60'
            }`}
          >
            {item.isHighlight && <span class="w-1.5 h-1.5 rounded-full bg-amber-400"></span>}
            <span>{item.title}</span>
            <svg class="w-3 h-3 text-slate-500 group-hover:text-cyan-400 group-hover:rotate-180 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
            </svg>
          </a>

          <!-- Dropdown Menu -->
          <div class="absolute left-0 top-full pt-2 w-72 opacity-0 translate-y-2 pointer-events-none group-hover:opacity-100 group-hover:translate-y-0 group-hover:pointer-events-auto transition-all duration-150 ease-out z-50">
            <div class="bg-[#0b1322] border border-[#1f2e4a] rounded-xl shadow-2xl p-3">
              <div class="px-2 py-1 text-[11px] font-mono text-cyan-400 uppercase tracking-wider mb-1.5 border-b border-slate-800">
                {item.title} · 二级专题分类
              </div>
              <div class="space-y-1">
                {item.subTopics.map((sub) => (
                  <a
                    href={sub.slug}
                    class="block p-2 rounded-lg hover:bg-slate-800/80 transition-colors group/sub"
                  >
                    <div class="font-medium text-xs text-slate-200 group-hover/sub:text-cyan-300 flex items-center justify-between">
                      <span class="whitespace-nowrap">{sub.title}</span>
                      <span class="text-[10px] font-mono text-slate-500">专题</span>
                    </div>
                    <p class="text-[11px] text-slate-400 line-clamp-1 mt-0.5">{sub.description}</p>
                  </a>
                ))}
              </div>
            </div>
          </div>
        </div>
      ))}
    </nav>

    <!-- Search & Quick CTA -->
    <div class="flex items-center space-x-2.5 shrink-0">
      <!-- Pagefind Search Trigger Button -->
      <button
        type="button"
        onclick="window.openGlobalSearch && window.openGlobalSearch()"
        class="flex items-center space-x-2 px-2.5 sm:px-3 py-1.5 rounded-lg bg-[#0f1a2e] hover:bg-slate-800 border border-[#1f2e4a] text-slate-400 hover:text-white text-xs font-mono transition-all shrink-0"
      >
        <svg class="w-3.5 h-3.5 text-cyan-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
        </svg>
        <span class="hidden sm:inline whitespace-nowrap">搜索机场/协议...</span>
        <kbd class="hidden md:inline-block px-1 py-0.2 rounded bg-slate-900 border border-slate-700 text-[10px] text-slate-400 font-mono">
          Ctrl K
        </kbd>
      </button>

      <!-- 光速云主推高亮快捷入口 -->
      <a
        href="/brands/guangsu"
        class="flex items-center space-x-1.5 px-3 py-1.5 rounded-lg bg-gradient-to-r from-cyan-500 to-blue-600 hover:from-cyan-400 hover:to-blue-500 text-white text-xs font-bold shadow-md shadow-cyan-500/20 transition-all hover:scale-105 shrink-0 whitespace-nowrap"
      >
        <span class="w-1.5 h-1.5 rounded-full bg-white animate-pulse"></span>
        <span>年度主推：光速云</span>
      </a>

      <!-- Mobile Menu Toggle Button (visible below xl) -->
      <button
        id="mobile-toggle"
        class="xl:hidden p-2 text-slate-400 hover:text-white rounded-lg hover:bg-slate-800 transition-colors"
        aria-label="切换菜单"
      >
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Drawer Menu -->
  <div id="mobile-menu" class="hidden xl:hidden border-t border-[#1f2e4a] bg-[#070c14] px-4 pt-3 pb-6 space-y-3">
    {navLinks.map((item) => (
      <div class="border-b border-slate-800/80 pb-2.5">
        <a href={item.slug} class="font-semibold text-cyan-400 text-sm block mb-1">
          {item.title}
        </a>
        <div class="grid grid-cols-2 gap-1 pl-2">
          {item.subTopics.map((sub) => (
            <a href={sub.slug} class="text-xs text-slate-300 py-1 hover:text-white truncate">
              › {sub.title}
            </a>
          ))}
        </div>
      </div>
    ))}
    <div class="pt-2">
      <a
        href="/brands/guangsu"
        class="block text-center py-2 px-4 rounded-lg bg-gradient-to-r from-cyan-500 to-blue-600 text-white font-bold text-xs shadow-md shadow-cyan-500/20"
      >
        ★ 查看年度主推：光速云万字深度测评报告
      </a>
    </div>
  </div>
</header>

<script is:inline>
  const toggleBtn = document.getElementById('mobile-toggle');
  const menu = document.getElementById('mobile-menu');
  if (toggleBtn && menu) {
    toggleBtn.addEventListener('click', () => {
      menu.classList.toggle('hidden');
    });
  }
</script>
