---
import type { Brand } from '../data/brands';

export interface Props {
  brand: Brand;
}

const { brand } = Astro.props;
const isTop = brand.ranking <= 3;
---

<div class={`relative rounded-xl border p-5 sm:p-6 transition-all duration-300 ${
  brand.isFeatured
    ? 'bg-gradient-to-b from-[#111c30] to-[#0b1322] border-cyan-500/50 shadow-xl shadow-cyan-500/10 ring-1 ring-cyan-500/30'
    : 'bg-[#0c1424] border-[#1f2e4a] hover:border-slate-600 hover:shadow-lg'
}`}>
  <!-- Top Bar: Ranking, Name, Badge, Status -->
  <div class="flex flex-wrap items-center justify-between gap-2 mb-3">
    <div class="flex items-center space-x-2.5 shrink-0">
      <span class={`font-mono font-bold text-sm px-2 py-0.5 rounded whitespace-nowrap shrink-0 ${
        brand.ranking === 1 ? 'bg-amber-400 text-slate-950 font-extrabold' :
        brand.ranking === 2 ? 'bg-slate-300 text-slate-950' :
        brand.ranking === 3 ? 'bg-amber-700 text-amber-100' :
        'bg-slate-800 text-slate-400'
      }`}>
        #{brand.ranking}
      </span>
      <h3 class="font-bold text-lg sm:text-xl text-white hover:text-cyan-400 transition-colors whitespace-nowrap">
        <a href={`/brands/${brand.id}`}>{brand.name}</a>
      </h3>
      {brand.isFeatured && (
        <span class="px-2 py-0.5 rounded-full text-[11px] font-bold bg-cyan-500/20 text-cyan-300 border border-cyan-400/40 animate-pulse whitespace-nowrap shrink-0">
          ★ 年度主推
        </span>
      )}
    </div>

    <!-- Data Status Badge -->
    <div class="flex items-center space-x-2 shrink-0">
      {brand.hasSpeedtestImage ? (
        <span class="inline-flex items-center space-x-1 px-2 py-0.5 rounded text-[10px] font-mono bg-emerald-950/60 text-emerald-400 border border-emerald-800 whitespace-nowrap shrink-0">
          <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
          <span>实测证据收录</span>
        </span>
      ) : (
        <span class="inline-flex items-center space-x-1 px-2 py-0.5 rounded text-[10px] font-mono bg-slate-900 text-slate-400 border border-slate-700 whitespace-nowrap shrink-0">
          <span>官方规格审计</span>
        </span>
      )}
      <span class="text-[11px] font-mono text-slate-400 px-2 py-0.5 rounded bg-slate-900/80 border border-slate-800 whitespace-nowrap shrink-0 hidden sm:inline-block">
        {brand.circuitType.split(' ')[0]}
      </span>
    </div>
  </div>

  <!-- Tagline / Summary -->
  <p class="text-xs text-slate-300 leading-relaxed mb-4 line-clamp-2">
    {brand.summary}
  </p>

  <!-- Key Specs Grid -->
  <div class="grid grid-cols-2 sm:grid-cols-4 gap-2 py-3 px-3.5 rounded-lg bg-[#070c14]/60 border border-slate-800/80 mb-4 font-mono text-xs">
    <div>
      <span class="text-slate-500 text-[10px] block uppercase">起步门槛</span>
      <span class="text-cyan-400 font-semibold">{brand.entryPrice}</span>
    </div>
    <div>
      <span class="text-slate-500 text-[10px] block uppercase">核心协议</span>
      <span class="text-slate-200">{brand.protocol}</span>
    </div>
    <div>
      <span class="text-slate-500 text-[10px] block uppercase">设备限制</span>
      <span class="text-slate-200 truncate">{brand.devices.split(' ')[0]}</span>
    </div>
    <div>
      <span class="text-slate-500 text-[10px] block uppercase">运营年份</span>
      <span class="text-slate-200">{brand.foundedYear}年</span>
    </div>
  </div>

  <!-- Speedtest Samples -->
  <div class="mb-4">
    <div class="flex items-center justify-between text-[11px] font-mono text-slate-400 mb-1.5">
      <span>节点平均延迟与实测带宽</span>
      {brand.speedtestImage && (
        <a href={`/brands/${brand.id}#speedtest`} class="text-cyan-400 hover:underline flex items-center space-x-0.5">
          <span>查看真机测速大图</span>
          <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
          </svg>
        </a>
      )}
    </div>
    <div class="grid grid-cols-2 sm:grid-cols-4 gap-1.5 font-mono text-xs">
      {brand.speedtests.slice(0, 4).map((item) => (
        <div class="bg-[#0b1322] px-2.5 py-1.5 rounded border border-slate-800">
          <div class="text-slate-400 text-[10px] truncate">{item.region}</div>
          <div class="flex items-center justify-between mt-0.5">
            <span class="text-emerald-400 font-medium">{item.download}</span>
            <span class="text-slate-400 text-[10px]">{item.latency}</span>
          </div>
        </div>
      ))}
    </div>
  </div>

  <!-- Coupon Code & CTA Actions -->
  <div class="flex flex-col sm:flex-row items-center justify-between gap-3 pt-3 border-t border-slate-800">
    <div class="flex items-center space-x-2 w-full sm:w-auto">
      {brand.couponCode ? (
        <div class="flex items-center space-x-1.5 px-2.5 py-1 rounded bg-amber-950/40 border border-amber-800/60 text-amber-300 font-mono text-xs">
          <span class="text-[10px] text-amber-500 uppercase">优惠码</span>
          <span class="font-bold">{brand.couponCode}</span>
          {brand.couponDiscount && <span class="text-[10px] text-amber-400">({brand.couponDiscount})</span>}
        </div>
      ) : (
        <span class="text-[11px] font-mono text-slate-500">直购无券活动</span>
      )}
    </div>

    <div class="flex items-center space-x-2 w-full sm:w-auto justify-end">
      <a
        href={`/brands/${brand.id}`}
        class="px-3 py-1.5 rounded-lg bg-slate-800 hover:bg-slate-700 text-slate-300 text-xs font-medium transition-colors"
      >
        详细万字评测
      </a>

      {brand.affiliateUrl ? (
        <a
          href={brand.affiliateUrl}
          target="_blank"
          rel="nofollow sponsored noopener"
          class={`px-4 py-1.5 rounded-lg text-xs font-semibold shadow-md transition-all flex items-center space-x-1 ${
            brand.isFeatured
              ? 'bg-gradient-to-r from-cyan-500 to-blue-600 hover:from-cyan-400 hover:to-blue-500 text-white shadow-cyan-500/20'
              : 'bg-cyan-600 hover:bg-cyan-500 text-white'
          }`}
        >
          <span>官网直达注册</span>
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
          </svg>
        </a>
      ) : (
        <span class="px-3 py-1.5 rounded-lg bg-slate-900 border border-slate-800 text-slate-500 text-xs font-mono">
          待更新官网链接
        </span>
      )}
    </div>
  </div>
</div>
