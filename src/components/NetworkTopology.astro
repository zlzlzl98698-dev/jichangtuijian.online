---
export interface Props {
  brandName?: string;
  circuitType?: string;
}

const { brandName = '光速云', circuitType = 'IEPL 专线 + 企业内网专线' } = Astro.props;
---

<div class="bg-[#0b1322] border border-[#1f2e4a] rounded-xl p-5 my-6 overflow-hidden">
  <div class="flex items-center justify-between border-b border-slate-800 pb-3 mb-4">
    <div class="flex items-center space-x-2">
      <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
      <h3 class="text-sm font-semibold text-white tracking-wide uppercase font-mono">
        {brandName} · 网络传输链路拓扑架构图 (Path Observatory)
      </h3>
    </div>
    <span class="text-[11px] font-mono text-cyan-400 bg-cyan-950/60 px-2 py-0.5 rounded border border-cyan-800">
      {circuitType}
    </span>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-5 gap-3 relative text-xs font-mono">
    <!-- Step 1: User Client -->
    <div class="bg-[#070c14] border border-slate-800 rounded-lg p-3 flex flex-col justify-between">
      <div>
        <div class="text-[10px] text-slate-500 uppercase">Step 01 / 发起端</div>
        <div class="font-bold text-slate-200 mt-1">本地用户设备</div>
        <p class="text-[11px] text-slate-400 mt-1">PC / Mac / iOS / Android / 软路由</p>
      </div>
      <div class="mt-3 pt-2 border-t border-slate-800/80 text-[10px] text-cyan-400">
        Clash Verge / 小火箭
      </div>
    </div>

    <!-- Arrow 1 -->
    <div class="hidden md:flex items-center justify-center text-slate-600">
      <div class="flex flex-col items-center">
        <span class="text-[9px] text-slate-400 mb-1">VLESS/TLS加密</span>
        <svg class="w-5 h-5 text-cyan-500 animate-pulse" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
        </svg>
      </div>
    </div>

    <!-- Step 2: Inbound Transit -->
    <div class="bg-[#070c14] border border-slate-800 rounded-lg p-3 flex flex-col justify-between">
      <div>
        <div class="text-[10px] text-slate-500 uppercase">Step 02 / 入口层</div>
        <div class="font-bold text-slate-200 mt-1">国内 BGP 入口机房</div>
        <p class="text-[11px] text-slate-400 mt-1">电信/联通/移动三网智能路由</p>
      </div>
      <div class="mt-3 pt-2 border-t border-slate-800/80 text-[10px] text-emerald-400">
        隐藏真实IP · 防QoS压制
      </div>
    </div>

    <!-- Arrow 2: Dedicated Cable -->
    <div class="hidden md:flex items-center justify-center text-slate-600">
      <div class="flex flex-col items-center">
        <span class="text-[9px] text-emerald-400 font-bold mb-1">物理专线直连</span>
        <svg class="w-5 h-5 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
        </svg>
        <span class="text-[8px] text-slate-500">不经过公网 GFW</span>
      </div>
    </div>

    <!-- Step 3: Outbound Exit & Services -->
    <div class="bg-[#070c14] border border-slate-800 rounded-lg p-3 flex flex-col justify-between">
      <div>
        <div class="text-[10px] text-slate-500 uppercase">Step 03 / 出口落地</div>
        <div class="font-bold text-slate-200 mt-1">全球原生落地节点</div>
        <p class="text-[11px] text-slate-400 mt-1">香港 / 日本 / 新加坡 / 美国</p>
      </div>
      <div class="mt-3 pt-2 border-t border-slate-800/80 text-[10px] text-purple-400">
        ChatGPT / Netflix 原生解锁
      </div>
    </div>
  </div>
</div>
