---
import Layout from '../../layouts/Layout.astro';
import BrandCard from '../../components/BrandCard.astro';
import { brands } from '../../data/brands';
import { navigationStructure } from '../../data/navigation';

const rankingNav = navigationStructure.find((n) => n.id === 'rankings');
const budgetBrands = brands.filter((b) => b.entryPrice.includes('5.') || b.entryPrice.includes('6') || b.entryPrice.includes('7') || b.entryPrice.includes('8'));
const dedicatedBrands = brands.filter((b) => b.circuitType.includes('专线') || b.circuitType.includes('IPLC') || b.circuitType.includes('IEPL'));
---

<Layout
  title="2026 机场推荐榜单 | 高性价比平价 vs 顶级IPLC专线排行榜 - 机场online"
  description="【2026权威选型】高性价比平价机场（5-15元/月）与顶级IPLC/IEPL物理专线双榜单。覆盖光速云主推双专线、微风网络、暮光加速、闪电鼠等品牌的真实测速跑分与稳定性对比。"
>
  <div class="mb-8">
    <div class="text-xs font-mono text-cyan-400 uppercase tracking-wider mb-2">
      Rankings & Benchmarks · 核心梯队推荐
    </div>
    <h1 class="text-3xl sm:text-4xl font-extrabold text-white">2026 年度机场权威推荐总榜</h1>
    <p class="text-slate-300 text-sm mt-2 max-w-3xl">
      根据晚高峰带宽吞吐量、丢包率、抗敏感期波动能力及价格梯度，分为两大核心二级专题：追求性价比的“平民轻量级”与追求极速低延迟的“物理专线级”。
    </p>

    <!-- Subtopic switch tabs -->
    <div class="flex items-center space-x-3 mt-6">
      <a href="/rankings/budget" class="px-4 py-2 rounded-lg bg-[#0b1322] border border-[#1f2e4a] hover:border-cyan-500/60 text-slate-200 text-xs font-mono">
        💰 高性价比平价机场专题 (5-15元档) →
      </a>
      <a href="/rankings/dedicated" class="px-4 py-2 rounded-lg bg-[#0b1322] border border-[#1f2e4a] hover:border-cyan-500/60 text-slate-200 text-xs font-mono">
        ⚡ 顶级 IPLC/IEPL 专线机场专题 →
      </a>
    </div>
  </div>

  <!-- Top 10 Showcase -->
  <section class="my-8">
    <h2 class="text-xl font-bold text-white mb-4 flex items-center space-x-2">
      <span class="w-2.5 h-2.5 rounded-full bg-amber-400"></span>
      <span>年度综合总榜前十强</span>
    </h2>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      {brands.slice(0, 10).map((b) => (
        <BrandCard brand={b} />
      ))}
    </div>
  </section>

  <!-- Deep Clusters Table from Navigation -->
  {rankingNav && (
    <section class="my-12 pt-8 border-t border-[#1f2e4a]">
      <h2 class="text-xl font-bold text-white mb-4">本专栏下辖内容知识集群</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {rankingNav.subTopics.map((sub) => (
          <div class="bg-[#0b1322] border border-[#1f2e4a] rounded-xl p-5">
            <h3 class="font-bold text-white text-base mb-2">
              <a href={sub.slug} class="hover:text-cyan-400">{sub.title}</a>
            </h3>
            <p class="text-xs text-slate-400 mb-4">{sub.description}</p>
            <div class="space-y-3 border-t border-slate-800 pt-3">
              {sub.clusters.map((c) => (
                <div>
                  <h4 class="text-xs font-bold text-cyan-300 font-mono">#{c.name}</h4>
                  <p class="text-[11px] text-slate-400 mb-2">{c.description}</p>
                  <ul class="space-y-1">
                    {c.articles.slice(0, 5).map((a) => (
                      <li class="text-xs text-slate-300 flex items-center justify-between hover:text-cyan-300 py-0.5">
                        <a href={`/articles/${a.slug}`} class="truncate pr-2 hover:text-cyan-400 hover:underline flex items-center space-x-1 text-slate-200">
                          <span class="text-cyan-500 font-bold">·</span>
                          <span class="truncate">{a.title}</span>
                        </a>
                        <span class="text-[10px] font-mono text-slate-500 flex-shrink-0">{a.intent}</span>
                      </li>
                    ))}
                  </ul>
                </div>
              ))}
            </div>
          </div>
        ))}
      </div>
    </section>
  )}
</Layout>
