---
import Layout from '../layouts/Layout.astro';
import BrandCard from '../components/BrandCard.astro';
import { pillarTopics } from '../data/pillars';
import { brands } from '../data/brands';

const topic = pillarTopics.find((p) => p.id === 'free-nodes')!;
const guangsu = brands.find((b) => b.id === 'guangsu') || brands[0];
const wuyou = brands.find((b) => b.id === 'wuyou') || brands[1];

const schema = {
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": topic.title,
  "description": topic.metaDescription,
  "author": {
    "@type": "Organization",
    "name": "机场online 网络安全实验室"
  },
  "publisher": {
    "@type": "Organization",
    "name": "机场online",
    "url": "https://jichangtuijian.online"
  },
  "datePublished": "2026-09-10T08:00:00+08:00",
  "dateModified": "2026-11-10T12:00:00+08:00"
};
---

<Layout title={topic.metaTitle} description={topic.metaDescription}>
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />

  <!-- Breadcrumb -->
  <nav class="flex items-center space-x-2 text-xs font-mono text-slate-400 mb-6 pb-3 border-b border-slate-800">
    <a href="/" class="hover:text-cyan-400">首页</a>
    <span>›</span>
    <span class="text-cyan-400">选型雷达专栏</span>
    <span>›</span>
    <span class="text-white">{topic.shortTitle}</span>
  </nav>

  <!-- Hero Section -->
  <header class="mb-10 relative overflow-hidden rounded-2xl bg-gradient-to-br from-[#191506] via-[#0f0c03] to-[#080602] border border-amber-900/40 p-6 sm:p-10 shadow-2xl">
    <div class="flex items-center space-x-2.5 mb-3">
      <span class="px-2.5 py-1 rounded-md text-[11px] font-mono font-bold bg-amber-950 text-amber-400 border border-amber-800 tracking-wider">
        {topic.badge}
      </span>
      <span class="text-xs font-mono text-slate-400">安全警示白皮书 · 2026 免费节点真相实测</span>
    </div>
    <h1 class="text-2xl sm:text-4xl font-extrabold text-white tracking-tight leading-tight mb-4">
      {topic.title}
    </h1>
    <p class="text-slate-300 text-sm sm:text-base leading-relaxed max-w-4xl mb-6">
      {topic.summary}
    </p>

    <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 border-t border-amber-950/80 pt-6 font-mono text-xs">
      <div class="bg-[#120f04] p-3 rounded-lg border border-amber-900/40">
        <div class="text-slate-500 text-[10px]">黑客蜜罐比例</div>
        <div class="text-rose-400 font-bold text-lg mt-0.5">超过 40%</div>
      </div>
      <div class="bg-[#120f04] p-3 rounded-lg border border-amber-900/40">
        <div class="text-slate-500 text-[10px]">平均存活周期</div>
        <div class="text-amber-400 font-bold text-lg mt-0.5">&lt; 2 小时</div>
      </div>
      <div class="bg-[#120f04] p-3 rounded-lg border border-amber-900/40">
        <div class="text-slate-500 text-[10px]">晚高峰平均丢包</div>
        <div class="text-rose-400 font-bold text-lg mt-0.5">30% - 50%</div>
      </div>
      <div class="bg-[#120f04] p-3 rounded-lg border border-amber-900/40">
        <div class="text-slate-500 text-[10px]">安全平替建议</div>
        <div class="text-emerald-400 font-bold text-lg mt-0.5">6.5元/月低门槛</div>
      </div>
    </div>
  </header>

  <!-- Deep Chapters Content -->
  <article class="space-y-10 my-12 text-slate-300 text-sm leading-relaxed">
    {topic.chapters.map((ch, idx) => (
      <section class="bg-[#0e0c03] border border-[#2a2209] rounded-xl p-6 sm:p-8">
        <h2 class="text-lg sm:text-xl font-bold text-white mb-4 flex items-center space-x-2">
          <span class="w-2 h-2 rounded-full bg-amber-400"></span>
          <span>{ch.title}</span>
        </h2>
        <div class="whitespace-pre-line text-slate-300 space-y-3 leading-relaxed">
          {ch.content}
        </div>
      </section>
    ))}
  </article>

  <!-- Low-Cost Safe Alternative Recommendations -->
  <section class="my-14">
    <div class="mb-6">
      <span class="text-xs font-mono text-cyan-400 uppercase">Safe Alternative · 安全合规低成本平替</span>
      <h2 class="text-xl sm:text-2xl font-bold text-white">不用裸奔：一杯奶茶钱的稳定专线方案</h2>
      <p class="text-slate-400 text-xs mt-1">别让免费节点偷走您的 ChatGPT 账号与个人隐私：</p>
    </div>
    <div class="space-y-6">
      <BrandCard brand={guangsu} isPriority={true} />
      <BrandCard brand={wuyou} />
    </div>
  </section>

  <!-- 8 Related Long-tail Articles Matrix -->
  <section class="bg-[#120f04] border border-amber-900/40 rounded-xl p-6 sm:p-8 my-14">
    <div class="mb-6">
      <span class="text-xs font-mono text-amber-400 uppercase">Knowledge Matrix · 长尾安全指南</span>
      <h2 class="text-xl sm:text-2xl font-bold text-white">免费节点专题：精选独立长尾深度文章</h2>
      <p class="text-slate-400 text-xs mt-1">围绕中间人窃密、OpenAI 封号、WARP 优选 IP 与蜜罐识别的 8 篇深度指南：</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      {topic.articles.map((art) => (
        <a
          href={`/articles/${art.slug}`}
          class="p-4 rounded-lg bg-[#1a1506] border border-amber-900/30 hover:border-amber-500/50 hover:bg-slate-800/40 transition-all group block"
        >
          <div class="flex items-center justify-between text-[11px] font-mono text-slate-400 mb-1.5">
            <span class="text-amber-400 font-bold"># {art.keyword}</span>
            <span class="text-slate-500 group-hover:text-amber-300">阅读全文 →</span>
          </div>
          <h3 class="text-sm font-semibold text-white group-hover:text-amber-300 line-clamp-1 mb-1">
            {art.title}
          </h3>
          <p class="text-xs text-slate-400 line-clamp-2">
            {art.searchIntent}
          </p>
        </a>
      ))}
    </div>
  </section>
</Layout>
