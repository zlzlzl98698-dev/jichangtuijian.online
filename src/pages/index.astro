---
import Layout from '../layouts/Layout.astro';
import BrandCard from '../components/BrandCard.astro';
import NetworkTopology from '../components/NetworkTopology.astro';
import PlanCalculator from '../components/PlanCalculator.astro';
import { brands } from '../data/brands';
import { navigationStructure } from '../data/navigation';
import { clientPlatforms } from '../data/clients';

const guangsu = brands.find((b) => b.id === 'guangsu') || brands[0];
const top10Brands = brands.slice(0, 10);
const verifiedBrands = brands.filter((b) => b.hasSpeedtestImage);
---

<Layout
  title="机场推荐2026 | 机场online - 42家主流机场测速/流媒体/ChatGPT解锁深度测评"
  description="【机场online 2026年度权威报告】深度收录42家机场品牌：主推光速云IEPL双专线架构、全网16家实测真机图谱、Netflix/ChatGPT解锁可用性、套餐价格与最新优惠码。全站蜂巢内链与Astro极速静态架构。"
  schema={{
    "@context": "https://schema.org",
    "@type": "ItemList",
    "name": "2026年度优质机场综合推荐榜单",
    "description": "基于真实晚高峰测速、IEPL专线低延迟、ChatGPT及Netflix流媒体解锁能力的42家机场评选",
    "itemListElement": brands.slice(0, 10).map((b, i) => ({
      "@type": "ListItem",
      "position": i + 1,
      "name": b.name,
      "url": `https://jichangtuijian.online/brands/${b.id}`
    }))
  }}
>
  <!-- Hero Section -->
  <section class="py-6 sm:py-12 border-b border-[#1f2e4a]/60">
    <div class="max-w-4xl">
      <div class="inline-flex items-center space-x-2 px-3 py-1 rounded-full bg-cyan-950/60 border border-cyan-800 text-cyan-400 text-xs font-mono mb-4">
        <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
        <span>2026 全球网络可观测实验室 (Network Observatory) · 42 品牌实时索引</span>
      </div>
      <h1 class="text-3xl sm:text-5xl font-extrabold text-white tracking-tight leading-tight mb-4">
        拒绝虚假玄学跑分，以
        <span class="text-transparent bg-clip-text bg-gradient-to-r from-cyan-400 via-sky-300 to-blue-500">
          真实测速图谱与专线架构
        </span>
        构建权威决策
      </h1>
      <p class="text-sm sm:text-base text-slate-300 leading-relaxed mb-6">
        机场online（jichangtuijian.online）是专注于跨境网络基础设施、专线稳定性、AI 工具大模型（ChatGPT/Claude）访问与 4K 流媒体解锁的权威技术测评站。本站对收录的 42 家机场实施
        <span class="text-cyan-400 font-mono">[measured 实测]</span>、
        <span class="text-blue-400 font-mono">[vendor 官方]</span>、
        <span class="text-amber-400 font-mono">[commercial 商业]</span>、
        <span class="text-purple-400 font-mono">[editorial 编辑]</span>
        四级数据分级，绝不虚构数据，确保全网透明度。
      </p>

      <!-- Key Quick Stats -->
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 font-mono text-xs">
        <div class="bg-[#0b1322] border border-slate-800 p-3 rounded-lg">
          <span class="text-slate-500 text-[10px] block uppercase">收录品牌规模</span>
          <span class="text-xl font-bold text-white">42 家机场</span>
        </div>
        <div class="bg-[#0b1322] border border-slate-800 p-3 rounded-lg">
          <span class="text-slate-500 text-[10px] block uppercase">真机测速存证</span>
          <span class="text-xl font-bold text-emerald-400">16 家原始图</span>
        </div>
        <div class="bg-[#0b1322] border border-slate-800 p-3 rounded-lg">
          <span class="text-slate-500 text-[10px] block uppercase">首推专线架构</span>
          <span class="text-xl font-bold text-cyan-400">光速云双专线</span>
        </div>
        <div class="bg-[#0b1322] border border-slate-800 p-3 rounded-lg">
          <span class="text-slate-500 text-[10px] block uppercase">最低入门门槛</span>
          <span class="text-xl font-bold text-amber-400">¥5.6 / 月起</span>
        </div>
      </div>
    </div>
  </section>

  <!-- Featured Spotlight: 光速云 (年度主推标杆) -->
  <section class="my-10">
    <div class="relative rounded-2xl bg-gradient-to-br from-[#0c182c] via-[#091120] to-[#060b14] border-2 border-cyan-500/60 p-6 sm:p-8 shadow-2xl shadow-cyan-500/10 overflow-hidden">
      <div class="absolute -right-16 -top-16 w-64 h-64 bg-cyan-500/10 blur-[80px] rounded-full pointer-events-none"></div>

      <div class="flex flex-wrap items-center justify-between gap-3 mb-4">
        <div class="flex items-center space-x-3">
          <span class="px-3 py-1 rounded-md bg-cyan-500 text-slate-950 font-black text-xs uppercase tracking-wider font-mono">
            ★ 2026 年度综合主推标杆
          </span>
          <h2 class="text-2xl sm:text-3xl font-extrabold text-white">
            <a href="/brands/guangsu" class="hover:text-cyan-300 transition-colors">光速云 (GuangSu Cloud)</a>
          </h2>
          <span class="text-xs font-mono text-slate-400 hidden sm:inline">2020 年稳定运营至今</span>
        </div>
        <div class="flex items-center space-x-2">
          <span class="px-2.5 py-1 rounded bg-amber-950/60 border border-amber-700/80 text-amber-300 font-mono text-xs">
            专属优惠码：<strong class="text-white text-sm">AMM</strong>
          </span>
        </div>
      </div>

      <p class="text-slate-300 text-sm leading-relaxed mb-6 max-w-4xl">
        光速云属于运营时间长达 6 年的老牌综合型机场，核心技术壁垒在于采用
        <strong class="text-cyan-300">「IEPL专线 + 企业级内网专线」双线路互备架构</strong>
        ，全节点支持现代高效 VLESS 协议。不仅提供全平台官方自研客户端，同时无缝兼容 Clash、Shadowrocket 等主流第三方订阅导入。实测香港节点可达 529Mbps，新加坡 387Mbps，是跨境电商、TikTok 运营、ChatGPT 4o 高频创作与海外 4K 流媒体的顶级全能之选。
      </p>

      <!-- Key packages highlight -->
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 mb-6">
        <div class="bg-[#060b13]/80 border border-slate-800 p-4 rounded-xl">
          <div class="text-slate-400 text-xs font-mono uppercase">轻量入门版</div>
          <div class="text-xl font-bold text-white mt-1">¥99 <span class="text-xs text-slate-400 font-normal">/ 年付 (折合¥8/月)</span></div>
          <p class="text-xs text-slate-400 mt-1">69GB/月 · 原生稳定专线 · 不限设备</p>
        </div>
        <div class="bg-[#060b13]/80 border border-cyan-500/30 p-4 rounded-xl ring-1 ring-cyan-500/20">
          <div class="text-cyan-400 text-xs font-mono uppercase font-bold">★ 极速主力版 (最推荐)</div>
          <div class="text-xl font-bold text-cyan-300 mt-1">¥25 <span class="text-xs text-slate-400 font-normal">/ 月付</span></div>
          <p class="text-xs text-slate-400 mt-1">168GB/月 · 全球IPLC 1倍率 · 2.5Gbps高吞吐</p>
        </div>
        <div class="bg-[#060b13]/80 border border-slate-800 p-4 rounded-xl">
          <div class="text-slate-400 text-xs font-mono uppercase">致敬斯诺克147永久套餐</div>
          <div class="text-xl font-bold text-white mt-1">¥147 <span class="text-xs text-slate-400 font-normal">/ 一次性付费</span></div>
          <p class="text-xs text-slate-400 mt-1">247GB永久有效不过期 · 出差备用神包</p>
        </div>
      </div>

      <!-- Action buttons -->
      <div class="flex flex-wrap items-center justify-between gap-4 pt-4 border-t border-slate-800">
        <div class="flex items-center space-x-4 text-xs font-mono text-slate-400">
          <span>✓ 支持支付宝 / 微信 / USDT</span>
          <span>✓ 晚高峰0丢包保障</span>
          <span>✓ 20+香港/10+日本/10+新加坡节点</span>
        </div>

        <div class="flex items-center space-x-3">
          <a
            href="/brands/guangsu"
            class="px-4 py-2 rounded-lg bg-slate-800 hover:bg-slate-700 text-slate-200 text-xs font-medium transition-colors"
          >
            阅读光速云万字深度测评报告
          </a>
          <a
            href={guangsu.affiliateUrl}
            target="_blank"
            rel="nofollow sponsored noopener"
            class="px-6 py-2 rounded-lg bg-gradient-to-r from-cyan-500 to-blue-600 hover:from-cyan-400 hover:to-blue-500 text-white font-bold text-xs shadow-lg shadow-cyan-500/30 transition-all hover:scale-105 flex items-center space-x-1.5"
          >
            <span>立即直达光速云官网注册</span>
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
            </svg>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Network Topology Visual Component -->
  <NetworkTopology brandName="全站推荐专线标准架构" circuitType="IEPL / IPLC 物理专线传输拓扑" />

  <!-- Interactive Smart Plan Matching Calculator -->
  <PlanCalculator />

  <!-- 5 Massive Topic Pillars: 选型决策雷达与知识库矩阵 -->
  <section class="my-14">
    <div class="flex items-center justify-between mb-6">
      <div>
        <span class="text-xs font-mono text-cyan-400 uppercase tracking-wider">Decision Radar · 决策雷达与知识矩阵</span>
        <h2 class="text-2xl sm:text-3xl font-extrabold text-white mt-1">五大万字级深度选型与避坑专栏</h2>
      </div>
      <span class="text-xs font-mono text-slate-400 hidden sm:inline">覆盖全网 95% 选型痛点 · AEO优先检索</span>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
      <!-- Pillar 1: 42家全景推荐 -->
      <a
        href="/best-airports"
        class="group p-6 rounded-2xl bg-gradient-to-br from-[#0c192c] via-[#070e1b] to-[#040812] border border-cyan-800/40 hover:border-cyan-400/80 transition-all shadow-xl hover:shadow-cyan-500/10 flex flex-col justify-between"
      >
        <div>
          <div class="flex items-center justify-between text-xs font-mono mb-3">
            <span class="px-2 py-0.5 rounded bg-cyan-950 text-cyan-400 border border-cyan-800 text-[10px]">
              全景选型雷达
            </span>
            <span class="text-slate-500">万字白皮书</span>
          </div>
          <h3 class="text-lg font-bold text-white group-hover:text-cyan-300 transition-colors mb-2">
            42 家机场综合选型白皮书
          </h3>
          <p class="text-slate-300 text-xs leading-relaxed line-clamp-3 mb-4">
            全网 42 家主流机场梯队划分、双 IEPL 专线拓扑、晚高峰 4K 压测与三维选型决策树，光速云首推基准。
          </p>
        </div>
        <div class="pt-3 border-t border-slate-800/80 flex items-center justify-between text-xs font-mono text-cyan-400 group-hover:translate-x-1 transition-transform">
          <span>阅读全景指南与参数总表</span>
          <span>→</span>
        </div>
      </a>

      <!-- Pillar 2: 免费试用大全 -->
      <a
        href="/trial"
        class="group p-6 rounded-2xl bg-gradient-to-br from-[#0c2419] via-[#06140d] to-[#030a06] border border-emerald-800/40 hover:border-emerald-400/80 transition-all shadow-xl hover:shadow-emerald-500/10 flex flex-col justify-between"
      >
        <div>
          <div class="flex items-center justify-between text-xs font-mono mb-3">
            <span class="px-2 py-0.5 rounded bg-emerald-950 text-emerald-400 border border-emerald-800 text-[10px]">
              0门槛试错
            </span>
            <span class="text-slate-500">万字白皮书</span>
          </div>
          <h3 class="text-lg font-bold text-white group-hover:text-emerald-300 transition-colors mb-2">
            免费与 1 元试用机场大全
          </h3>
          <p class="text-slate-300 text-xs leading-relaxed line-clamp-3 mb-4">
            拒绝盲目年付！整理全网支持 0 元白嫖、1 元体验包与 24 小时退款保障的靠谱机场，附 10 分钟晚高峰压测 SOP。
          </p>
        </div>
        <div class="pt-3 border-t border-slate-800/80 flex items-center justify-between text-xs font-mono text-emerald-400 group-hover:translate-x-1 transition-transform">
          <span>查看试用清单与避坑指南</span>
          <span>→</span>
        </div>
      </a>

      <!-- Pillar 3: 跑路预警雷达 -->
      <a
        href="/scam-radar"
        class="group p-6 rounded-2xl bg-gradient-to-br from-[#240c17] via-[#14060c] to-[#0a0306] border border-rose-800/40 hover:border-rose-400/80 transition-all shadow-xl hover:shadow-rose-500/10 flex flex-col justify-between"
      >
        <div>
          <div class="flex items-center justify-between text-xs font-mono mb-3">
            <span class="px-2 py-0.5 rounded bg-rose-950 text-rose-400 border border-rose-800 text-[10px]">
              避坑防骗雷达
            </span>
            <span class="text-slate-500">万字白皮书</span>
          </div>
          <h3 class="text-lg font-bold text-white group-hover:text-rose-300 transition-colors mb-2">
            翻墙机场跑路预警雷达
          </h3>
          <p class="text-slate-300 text-xs leading-relaxed line-clamp-3 mb-4">
            敢爆黑料！复盘 30+ 历史跑路惨案，解密物理专线机房断约真相，总结 7 大跑路红色预警信号与月付避险准则。
          </p>
        </div>
        <div class="pt-3 border-t border-slate-800/80 flex items-center justify-between text-xs font-mono text-rose-400 group-hover:translate-x-1 transition-transform">
          <span>查看跑路预警与避险法则</span>
          <span>→</span>
        </div>
      </a>

      <!-- Pillar 4: 免费节点真相 -->
      <a
        href="/free-nodes"
        class="group p-6 rounded-2xl bg-gradient-to-br from-[#241c0c] via-[#140f06] to-[#0a0803] border border-amber-800/40 hover:border-amber-400/80 transition-all shadow-xl hover:shadow-amber-500/10 flex flex-col justify-between"
      >
        <div>
          <div class="flex items-center justify-between text-xs font-mono mb-3">
            <span class="px-2 py-0.5 rounded bg-amber-950 text-amber-400 border border-amber-800 text-[10px]">
              白嫖风险解密
            </span>
            <span class="text-slate-500">万字白皮书</span>
          </div>
          <h3 class="text-lg font-bold text-white group-hover:text-amber-300 transition-colors mb-2">
            免费节点安全与风险实测
          </h3>
          <p class="text-slate-300 text-xs leading-relaxed line-clamp-3 mb-4">
            免费往往最昂贵！网络安全实验室抓包实测：中间人攻击（MITM）如何盗取 Cookie 与密码？如何用一杯奶茶钱安全替换。
          </p>
        </div>
        <div class="pt-3 border-t border-slate-800/80 flex items-center justify-between text-xs font-mono text-amber-400 group-hover:translate-x-1 transition-transform">
          <span>查看免费节点抓包实测</span>
          <span>→</span>
        </div>
      </a>

      <!-- Pillar 5: 机场百科FAQ -->
      <a
        href="/faq"
        class="group p-6 rounded-2xl bg-gradient-to-br from-[#121c2e] via-[#09101d] to-[#040810] border border-blue-800/40 hover:border-blue-400/80 transition-all shadow-xl hover:shadow-blue-500/10 flex flex-col justify-between lg:col-span-2"
      >
        <div>
          <div class="flex items-center justify-between text-xs font-mono mb-3">
            <span class="px-2 py-0.5 rounded bg-blue-950 text-blue-400 border border-blue-800 text-[10px]">
              AEO / GEO 标准知识库
            </span>
            <span class="text-slate-500">100 个核心疑难全解</span>
          </div>
          <h3 class="text-lg font-bold text-white group-hover:text-blue-300 transition-colors mb-2">
            科学上网与商业机场全维度百科辞典
          </h3>
          <p class="text-slate-300 text-xs leading-relaxed line-clamp-2 mb-4">
            内置标准 Schema FAQPage 结构化数据，收录节点测速正常但打不开网页、ChatGPT 1020 报错、Netflix 代理检测、DNS 污染等 100 个权威技术问答。
          </p>
        </div>
        <div class="pt-3 border-t border-slate-800/80 flex items-center justify-between text-xs font-mono text-blue-400 group-hover:translate-x-1 transition-transform">
          <span>检索 100 个技术与排障问答</span>
          <span>→</span>
        </div>
      </a>
    </div>
  </section>

  <!-- 42 Brands Full Directory Grid with Filter -->
  <section class="my-12" id="brands-section">
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-6">
      <div>
        <div class="flex items-center space-x-2">
          <span class="w-2.5 h-2.5 rounded-full bg-cyan-400"></span>
          <h2 class="text-2xl font-bold text-white tracking-tight">42 家机场品牌全景检索矩阵</h2>
        </div>
        <p class="text-xs text-slate-400 font-mono mt-1">
          排序规则：前10强权威推荐 → 中坚专线梯队(11-28) → 后置观察档案(29-42)
        </p>
      </div>

      <!-- Quick Filter Buttons (Client-side interactive) -->
      <div class="flex items-center space-x-1.5 bg-[#0b1322] border border-[#1f2e4a] p-1 rounded-lg text-xs font-mono">
        <button onclick="filterBrands('all')" class="filter-btn px-3 py-1 rounded bg-cyan-600 text-white font-medium" data-target="all">全部 (42)</button>
        <button onclick="filterBrands('top10')" class="filter-btn px-3 py-1 rounded text-slate-400 hover:text-white" data-target="top10">前十强 (10)</button>
        <button onclick="filterBrands('verified')" class="filter-btn px-3 py-1 rounded text-slate-400 hover:text-white" data-target="verified">实测存证 (16)</button>
        <button onclick="filterBrands('budget')" class="filter-btn px-3 py-1 rounded text-slate-400 hover:text-white" data-target="budget">平价平民 (15)</button>
      </div>
    </div>

    <!-- Brands Grid Container -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4" id="brand-grid">
      {brands.map((b) => (
        <div class="brand-item" data-rank={b.ranking} data-verified={b.hasSpeedtestImage ? '1' : '0'} data-price={b.entryPrice}>
          <BrandCard brand={b} />
        </div>
      ))}
    </div>
  </section>

  <!-- Interactive JavaScript for filtering -->
  <script is:inline>
    function filterBrands(category) {
      const items = document.querySelectorAll('.brand-item');
      const buttons = document.querySelectorAll('.filter-btn');

      buttons.forEach(btn => {
        if (btn.getAttribute('data-target') === category) {
          btn.className = 'filter-btn px-3 py-1 rounded bg-cyan-600 text-white font-medium';
        } else {
          btn.className = 'filter-btn px-3 py-1 rounded text-slate-400 hover:text-white';
        }
      });

      items.forEach(el => {
        const rank = parseInt(el.getAttribute('data-rank') || '99');
        const isVerified = el.getAttribute('data-verified') === '1';
        const price = el.getAttribute('data-price') || '';

        if (category === 'all') {
          el.style.display = 'block';
        } else if (category === 'top10') {
          el.style.display = rank <= 10 ? 'block' : 'none';
        } else if (category === 'verified') {
          el.style.display = isVerified ? 'block' : 'none';
        } else if (category === 'budget') {
          el.style.display = (price.includes('5.') || price.includes('6') || price.includes('7') || price.includes('8') || price.includes('9')) ? 'block' : 'none';
        }
      });
    }
  </script>

  <!-- Topic Hubs & Knowledge Clusters Section -->
  <section class="my-16 pt-10 border-t border-[#1f2e4a]">
    <div class="mb-8">
      <div class="text-xs font-mono text-cyan-400 uppercase tracking-wider mb-1">
        Information Architecture · 蜂巢式内链图谱
      </div>
      <h2 class="text-2xl font-bold text-white">五大一级导航与核心二级专题矩阵</h2>
      <p class="text-xs text-slate-400 mt-1">覆盖从新手客户端下载、专线底层协议、ChatGPT防封风控到跨境电商出海落地</p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
      {navigationStructure.map((nav) => (
        <div class="bg-[#0b1322] border border-[#1f2e4a] rounded-xl p-5 flex flex-col justify-between hover:border-cyan-500/40 transition-colors">
          <div>
            <div class="flex items-center justify-between mb-2">
              <h3 class="font-bold text-base text-white">{nav.title}</h3>
              {nav.badge && <span class="text-[10px] font-mono text-cyan-400 px-1.5 py-0.5 rounded bg-cyan-950 border border-cyan-800">{nav.badge}</span>}
            </div>
            <p class="text-xs text-slate-400 mb-4">{nav.description}</p>
            <div class="space-y-2 border-t border-slate-800 pt-3">
              {nav.subTopics.map((sub) => (
                <div class="text-xs">
                  <a href={sub.slug} class="font-medium text-slate-200 hover:text-cyan-400 flex items-center justify-between">
                    <span>› {sub.title}</span>
                    <span class="text-[10px] font-mono text-slate-500">{sub.clusters.length} 个集群</span>
                  </a>
                  <p class="text-[11px] text-slate-500 truncate mt-0.5">{sub.description}</p>
                </div>
              ))}
            </div>
          </div>
          <div class="mt-4 pt-3 border-t border-slate-800/80">
            <a href={nav.slug} class="text-xs font-mono text-cyan-400 hover:underline flex items-center space-x-1">
              <span>探索全部专题与集群</span>
              <span>→</span>
            </a>
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- Client Platforms Quick Guide Section -->
  <section class="my-16 pt-10 border-t border-[#1f2e4a]">
    <div class="flex items-center justify-between mb-8">
      <div>
        <h2 class="text-2xl font-bold text-white">2026 全平台客户端下载与推荐总览</h2>
        <p class="text-xs text-slate-400 mt-1">支持 Clash Verge Rev、v2rayN、Shadowrocket 小火箭、sing-box 等主流内核</p>
      </div>
      <a href="/clients" class="text-xs font-mono text-cyan-400 hover:underline">
        查看完整 6 大系统教程库 →
      </a>
    </div>

    <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-3 font-mono text-xs">
      {clientPlatforms.map((cp) => (
        <a href={`/clients#${cp.slug}`} class="bg-[#0b1322] border border-[#1f2e4a] hover:border-cyan-500/50 p-3 rounded-xl block text-center transition-all hover:scale-105">
          <div class="text-slate-300 font-bold mb-1 truncate">{cp.os.split(' ')[0]}</div>
          <div class="text-[10px] text-cyan-400">{cp.apps.length} 款主流工具</div>
          <div class="text-[9px] text-slate-500 truncate mt-1">{cp.apps[0].name}</div>
        </a>
      ))}
    </div>
  </section>
</Layout>
