---
import Layout from '../../layouts/Layout.astro';
import { navigationStructure } from '../../data/navigation';

const subTopic = navigationStructure[4].subTopics[0];
---

<Layout
  title="主流代理传输协议全解析 2026 | VLESS-Reality vs Trojan vs Hysteria 2 - 机场online"
  description="【传输协议白皮书】深度剖析 VLESS-Reality 借牌证书伪装原理、Hysteria 2 暴力 UDP 拥塞控制、Trojan 原生 HTTPS 伪装与 Shadowsocks 在专线内网中的现代应用。"
>
  <!-- Breadcrumb -->
  <nav class="flex items-center space-x-2 text-xs font-mono text-slate-400 mb-6 pb-3 border-b border-slate-800">
    <a href="/" class="hover:text-cyan-400">首页</a>
    <span>›</span>
    <a href="/tech" class="hover:text-cyan-400">协议与网络实验室</a>
    <span>›</span>
    <span class="text-white">传输协议与抗封锁技术专题</span>
  </nav>

  <div class="mb-8">
    <div class="text-xs font-mono text-cyan-400 uppercase tracking-wider mb-2">
      Protocol Science · 协议硬核深度
    </div>
    <h1 class="text-3xl sm:text-4xl font-extrabold text-white">传输协议与抗封锁技术白皮书</h1>
    <p class="text-slate-300 text-sm mt-2 max-w-3xl leading-relaxed">
      为什么 2026 年 VMess 协议已几乎被高端机场完全弃用？为什么 VLESS + Reality 与 Trojan 成为专线时代的主导标准？以下为你深度揭晓。
    </p>
  </div>

  <!-- Protocol Comparison Table -->
  <div class="overflow-x-auto rounded-xl border border-[#1f2e4a] bg-[#0b1322] my-8 font-mono text-xs">
    <table class="w-full text-left">
      <thead class="bg-[#070c14] border-b border-slate-800 text-slate-400 uppercase">
        <tr>
          <th class="py-3 px-4">协议名称</th>
          <th class="py-3 px-4">加密与传输机制</th>
          <th class="py-3 px-4">抗封锁与伪装特性</th>
          <th class="py-3 px-4">性能开销</th>
          <th class="py-3 px-4">适用网络环境</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-slate-800/80 text-slate-300">
        <tr class="hover:bg-slate-800/40">
          <td class="py-3 px-4 font-bold text-cyan-400">VLESS + Reality</td>
          <td class="py-3 px-4">无状态轻量加密 + 借用真实域名 TLS</td>
          <td class="py-3 px-4 text-emerald-400">极高（消除 TLS 指纹）</td>
          <td class="py-3 px-4 text-emerald-400">极低（原生性能）</td>
          <td class="py-3 px-4">公网高阻断敏感环境</td>
        </tr>
        <tr class="hover:bg-slate-800/40">
          <td class="py-3 px-4 font-bold text-purple-400">Hysteria 2</td>
          <td class="py-3 px-4">基于 QUIC / UDP 暴力拥塞控制</td>
          <td class="py-3 px-4 text-amber-400">中等（易受运营商 UDP QoS 压制）</td>
          <td class="py-3 px-4 text-cyan-400">极高吞吐（起死回生）</td>
          <td class="py-3 px-4">严重丢包高延迟恶劣网络</td>
        </tr>
        <tr class="hover:bg-slate-800/40">
          <td class="py-3 px-4 font-bold text-white">Trojan</td>
          <td class="py-3 px-4">模仿真实 HTTPS 网站认证机制</td>
          <td class="py-3 px-4 text-emerald-400">高（原生标准 TLS）</td>
          <td class="py-3 px-4 text-slate-300">中等</td>
          <td class="py-3 px-4">常规专线与中转节点</td>
        </tr>
        <tr class="hover:bg-slate-800/40">
          <td class="py-3 px-4 font-bold text-slate-400">Shadowsocks</td>
          <td class="py-3 px-4">对称流加密 (AEAD)</td>
          <td class="py-3 px-4 text-rose-400">低（公网直连已被精准识别）</td>
          <td class="py-3 px-4 text-emerald-400">极低</td>
          <td class="py-3 px-4">仅限 IEPL/IPLC 物理内网直连</td>
        </tr>
      </tbody>
    </table>
  </div>

  <!-- Clusters Section -->
  <section class="bg-[#0b1322] border border-[#1f2e4a] rounded-xl p-6 my-10">
    <h2 class="text-lg font-bold text-white mb-4">协议与拓扑知识集群 (20篇深度指南)</h2>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {subTopic.clusters.map((c) => (
        <div class="border-t border-slate-800 pt-3">
          <h3 class="font-mono text-xs font-bold text-cyan-400 uppercase mb-1">
            <a href={`/clusters/${c.id}`} class="hover:underline flex items-center space-x-1">
              <span>#{c.name}</span>
              <span class="text-[10px] text-slate-500 font-normal">→ 完整集群</span>
            </a>
          </h3>
          <p class="text-xs text-slate-400 mb-3">{c.description}</p>
          <ul class="space-y-1.5 text-xs">
            {c.articles.map((a) => (
              <li class="text-slate-300 flex items-center justify-between hover:text-cyan-300 py-0.5">
                <a href={`/articles/${a.slug}`} class="truncate pr-2 hover:text-cyan-400 hover:underline flex items-center space-x-1 text-slate-200">
                  <span class="text-cyan-500 font-bold">›</span>
                  <span class="truncate">{a.title}</span>
                </a>
                <span class="text-[10px] font-mono text-slate-500 shrink-0">{a.keyword}</span>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </section>
</Layout>
