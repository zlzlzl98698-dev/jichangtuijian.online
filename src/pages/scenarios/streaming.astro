---
import Layout from '../../layouts/Layout.astro';
import BrandCard from '../../components/BrandCard.astro';
import { brands } from '../../data/brands';
import { navigationStructure } from '../../data/navigation';

const streamBrands = brands.filter((b) => 
  b.id === 'guangsu' || 
  b.id === 'feimao' || 
  b.id === 'wuyou' || 
  b.id === 'xingdaomeng' ||
  b.id === 'weitu'
);

const subTopic = navigationStructure[2].subTopics[1];
---

<Layout
  title="TikTok 跨境电商与 4K 流媒体机场推荐 2026 | Netflix全解锁与防0播放 - 机场online"
  description="【跨境出海与4K影音】TikTok 直播推流、达人带货 0 播放破局与账号防关联方案。全区解锁 Netflix、Disney+ 4K HDR，大屏电视与 Apple TV 极简配置教程。"
>
  <!-- Breadcrumb -->
  <nav class="flex items-center space-x-2 text-xs font-mono text-slate-400 mb-6 pb-3 border-b border-slate-800">
    <a href="/" class="hover:text-cyan-400">首页</a>
    <span>›</span>
    <a href="/scenarios" class="hover:text-cyan-400">专用场景加速</a>
    <span>›</span>
    <span class="text-white">跨境出海与 4K 流媒体专题</span>
  </nav>

  <div class="mb-8">
    <div class="text-xs font-mono text-purple-400 uppercase tracking-wider mb-2">
      Cross-Border & Entertainment · 影音与出海
    </div>
    <h1 class="text-3xl sm:text-4xl font-extrabold text-white">TikTok 跨境出海与 4K 流媒体解锁专题</h1>
    <p class="text-slate-300 text-sm mt-2 max-w-3xl leading-relaxed">
      解决 TikTok 视频发出去 0 播放的节点风控判定，满足美区与东南亚直播推流的持续高上行带宽要求，同时彻底搞定 Netflix “只能看自制剧”的 IP 降级困扰。
    </p>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-12">
    {streamBrands.map((b) => (
      <BrandCard brand={b} />
    ))}
  </div>

  <!-- Clusters Section -->
  <section class="bg-[#0b1322] border border-[#1f2e4a] rounded-xl p-6">
    <h2 class="text-lg font-bold text-white mb-4">出海与流媒体知识集群 (20篇实操指南)</h2>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {subTopic.clusters.map((c) => (
        <div class="border-t border-slate-800 pt-3">
          <h3 class="font-mono text-xs font-bold text-cyan-400 uppercase mb-1">
            <a href={`/clusters/${c.id}`} class="hover:underline flex items-center space-x-1">
              <span>#{c.name}</span>
              <span class="text-[10px] text-slate-500 font-normal">→ 完整集群</span>
            </a>
          </h3>
          <p class="text-xs text-slate-400 mb-3">{c.description}</p>
          <ul class="space-y-1.5 text-xs">
            {c.articles.map((a) => (
              <li class="text-slate-300 flex items-center justify-between hover:text-cyan-300 py-0.5">
                <a href={`/articles/${a.slug}`} class="truncate pr-2 hover:text-cyan-400 hover:underline flex items-center space-x-1 text-slate-200">
                  <span class="text-cyan-500 font-bold">›</span>
                  <span class="truncate">{a.title}</span>
                </a>
                <span class="text-[10px] font-mono text-slate-500 shrink-0">{a.keyword}</span>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </section>
</Layout>
