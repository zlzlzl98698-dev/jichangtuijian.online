---
import Layout from '../../layouts/Layout.astro';
import { clientPlatforms } from '../../data/clients';
import { navigationStructure } from '../../data/navigation';

const desktopPlatforms = clientPlatforms.filter(p => ['windows', 'macos', 'linux'].includes(p.slug));
const subTopic = navigationStructure[3].subTopics[0];
---

<Layout
  title="电脑端机场客户端大全 (Windows / Mac / Linux) | Clash Verge Rev 与 v2rayN 深度教程 - 机场online"
  description="【桌面端翻墙客户端指南】涵盖 Windows 10/11、macOS Apple Silicon M系列与 Linux 平台的 Clash Verge Rev、v2rayN、sing-box 官方下载、TUN 系统级代理与终端环境配置教程。"
>
  <!-- Breadcrumb -->
  <nav class="flex items-center space-x-2 text-xs font-mono text-slate-400 mb-6 pb-3 border-b border-slate-800">
    <a href="/" class="hover:text-cyan-400">首页</a>
    <span>›</span>
    <a href="/clients" class="hover:text-cyan-400">客户端与教程</a>
    <span>›</span>
    <span class="text-white">桌面端应用专题</span>
  </nav>

  <div class="mb-8">
    <div class="text-xs font-mono text-cyan-400 uppercase tracking-wider mb-2">
      Desktop Ecosystem · 桌面电脑专属专栏
    </div>
    <h1 class="text-3xl sm:text-4xl font-extrabold text-white">电脑端机场代理软件 (Windows / Mac / Linux)</h1>
    <p class="text-slate-300 text-sm mt-2 max-w-3xl leading-relaxed">
      2026 年桌面端首选推荐 <strong>Clash Verge Rev</strong>（Mihomo 内核，完美支持 TUN 模式和全局接管）与 <strong>v2rayN</strong>（支持 Xray 和 sing-box 核心）。以下提供官方项目地址、架构区别与保姆级安装配置。
    </p>
  </div>

  <div class="space-y-8 my-8">
    {desktopPlatforms.map((platform) => (
      <div class="bg-[#0b1322] border border-[#1f2e4a] rounded-xl p-6">
        <h2 class="text-lg font-bold text-white mb-4 flex items-center space-x-2">
          <span class="w-2 h-2 rounded-full bg-cyan-400"></span>
          <span>{platform.os}</span>
        </h2>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
          {platform.apps.map((app) => (
            <div class="bg-[#070c14] border border-slate-800 p-4 rounded-lg flex flex-col justify-between">
              <div>
                <div class="flex items-center justify-between mb-1">
                  <h3 class="font-bold text-cyan-300 text-sm">{app.name}</h3>
                  <span class="text-[10px] font-mono px-1.5 py-0.5 rounded bg-slate-900 border border-slate-800 text-slate-400">{app.kernel}</span>
                </div>
                <p class="text-xs text-slate-300 mb-3">{app.desc}</p>
              </div>
              <div class="pt-2 border-t border-slate-800/80">
                <a href={app.link} target="_blank" rel="nofollow noopener noreferrer" class="text-xs font-mono text-cyan-400 hover:underline">
                  GitHub 官方下载 ↗
                </a>
              </div>
            </div>
          ))}
        </div>
      </div>
    ))}
  </div>

  <!-- Clusters Section -->
  <section class="bg-[#0b1322] border border-[#1f2e4a] rounded-xl p-6 my-10">
    <h2 class="text-lg font-bold text-white mb-4">桌面端知识集群 (20篇实操指南)</h2>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {subTopic.clusters.map((c) => (
        <div class="border-t border-slate-800 pt-3">
          <h3 class="font-mono text-xs font-bold text-cyan-400 uppercase mb-1">
            <a href={`/clusters/${c.id}`} class="hover:underline flex items-center space-x-1">
              <span>#{c.name}</span>
              <span class="text-[10px] text-slate-500 font-normal">→ 完整集群</span>
            </a>
          </h3>
          <p class="text-xs text-slate-400 mb-3">{c.description}</p>
          <ul class="space-y-1.5 text-xs">
            {c.articles.map((a) => (
              <li class="text-slate-300 flex items-center justify-between hover:text-cyan-300 py-0.5">
                <a href={`/articles/${a.slug}`} class="truncate pr-2 hover:text-cyan-400 hover:underline flex items-center space-x-1 text-slate-200">
                  <span class="text-cyan-500 font-bold">›</span>
                  <span class="truncate">{a.title}</span>
                </a>
                <span class="text-[10px] font-mono text-slate-500 shrink-0">{a.keyword}</span>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </section>
</Layout>
