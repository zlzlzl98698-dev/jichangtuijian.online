---
import Layout from '../../layouts/Layout.astro';
import { clientPlatforms } from '../../data/clients';
import { navigationStructure } from '../../data/navigation';

const clientNav = navigationStructure.find((n) => n.id === 'clients');
---

<Layout
  title="2026 机场代理客户端大全 | Windows / Mac / iOS / Android / 软路由官方下载与使用教程 - 机场online"
  description="【全平台客户端指南】涵盖 Clash Verge Rev、v2rayN、Shadowrocket 小火箭、sing-box、OpenClash 等客户端官方下载地址、内核特性、订阅导入与 TUN 模式分流保姆级配置教程。"
>
  <div class="mb-8">
    <div class="text-xs font-mono text-cyan-400 uppercase tracking-wider mb-2">
      Client Ecosystem · 全平台应用生态
    </div>
    <h1 class="text-3xl sm:text-4xl font-extrabold text-white">2026 机场代理客户端官方下载与教程大全</h1>
    <p class="text-slate-300 text-sm mt-2 max-w-3xl leading-relaxed">
      主流机场代理客户端分为两大类：<strong>第三方通用客户端</strong>（如 Clash Verge Rev、v2rayN、小火箭等，支持导入通用订阅链接）与<strong>机场专属客户端</strong>（如光速云、飞猫云等自研免配 App，下载登录即用）。以下按操作系统汇总主流客户端项目地址与核心功能定位。
    </p>

    <!-- Subtopic Links -->
    <div class="flex items-center space-x-3 mt-6">
      <a href="/clients/desktop" class="px-4 py-2 rounded-lg bg-[#0b1322] border border-[#1f2e4a] hover:border-cyan-500/60 text-slate-200 text-xs font-mono">
        💻 桌面端应用专题 (Windows / Mac / Linux) →
      </a>
      <a href="/clients/mobile" class="px-4 py-2 rounded-lg bg-[#0b1322] border border-[#1f2e4a] hover:border-cyan-500/60 text-slate-200 text-xs font-mono">
        📱 移动端与软路由专题 (iOS / Android / OpenWrt) →
      </a>
    </div>
  </div>

  <!-- Client Platforms Grid -->
  <div class="space-y-10 my-10">
    {clientPlatforms.map((platform) => (
      <div id={platform.slug} class="bg-[#0b1322] border border-[#1f2e4a] rounded-xl p-6">
        <div class="flex items-center justify-between border-b border-slate-800 pb-3 mb-4">
          <h2 class="text-xl font-bold text-white flex items-center space-x-2">
            <span class="w-2 h-2 rounded-full bg-cyan-400"></span>
            <span>{platform.os}</span>
          </h2>
          <span class="text-xs font-mono text-slate-400">收录 {platform.apps.length} 款推荐工具</span>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
          {platform.apps.map((app) => (
            <div class="bg-[#070c14] border border-slate-800/90 rounded-lg p-4 flex flex-col justify-between hover:border-slate-600 transition-colors">
              <div>
                <div class="flex items-center justify-between mb-1.5">
                  <h3 class="font-bold text-sm text-cyan-300">{app.name}</h3>
                  <span class="text-[10px] font-mono px-1.5 py-0.5 rounded bg-slate-900 border border-slate-800 text-slate-400">
                    {app.kernel}
                  </span>
                </div>
                <p class="text-xs text-slate-300 leading-relaxed mb-4">{app.desc}</p>
              </div>

              <div class="pt-3 border-t border-slate-800/80 flex items-center justify-between">
                <span class="text-[10px] font-mono text-slate-500">开源项目 / AppStore</span>
                <a
                  href={app.link}
                  target="_blank"
                  rel="nofollow noopener noreferrer"
                  class="text-xs font-mono text-cyan-400 hover:text-cyan-300 flex items-center space-x-1"
                >
                  <span>官方项目下载</span>
                  <span>↗</span>
                </a>
              </div>
            </div>
          ))}
        </div>
      </div>
    ))}
  </div>

  <!-- Clusters Section -->
  {clientNav && (
    <section class="bg-[#0b1322] border border-[#1f2e4a] rounded-xl p-6 my-10">
      <h2 class="text-lg font-bold text-white mb-4">客户端与教程知识图谱 (40篇深度专题)</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {clientNav.subTopics.map((sub) => (
          <div>
            <h3 class="text-sm font-bold text-cyan-400 mb-2 font-mono">› {sub.title}</h3>
            <ul class="space-y-1.5 text-xs text-slate-300">
              {sub.clusters.flatMap((c) => c.articles).slice(0, 8).map((a) => (
                <li class="flex items-center justify-between hover:text-cyan-300 py-0.5">
                  <a href={`/articles/${a.slug}`} class="truncate pr-2 hover:text-cyan-400 hover:underline flex items-center space-x-1 text-slate-200">
                    <span class="text-cyan-500 font-bold">·</span>
                    <span class="truncate">{a.title}</span>
                  </a>
                  <span class="text-[10px] font-mono text-slate-500 shrink-0">{a.keyword}</span>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </section>
  )}
</Layout>
